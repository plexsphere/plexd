        <mxCell id="security-signing-key-rotation-11" value="&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;Install as the only trusted key&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;(no grace window)&lt;/span&gt;" style="text;fillColor=#F6F5F1;strokeColor=none;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="137" y="322.9" width="259" height="41" as="geometry"/></mxCell>
