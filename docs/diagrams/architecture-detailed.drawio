        <mxCell id="architecture-detailed-20" value="&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;HTTPS + SSE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;outbound only&lt;/span&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="695" y="199.5" width="129" height="41" as="geometry"/></mxCell>
        <mxCell id="architecture-detailed-21" value="&lt;span style=&quot;font-size:20px;color:#1E6B40;font-weight:bold;&quot;&gt;Mesh side&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#55606E;font-family:IBM Plex Mono;&quot;&gt;10.100.1.250&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;NAT relay&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FDFCF9;strokeColor=#2F8A57;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=16;fontColor=#1E6B40;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="729" y="362" width="407" height="84" as="geometry"/></mxCell>
        <mxCell id="architecture-detailed-22" value="&lt;span style=&quot;font-size:20px;color:#1E6B40;font-weight:bold;&quot;&gt;Encrypted WireGuard mesh, full mesh&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;Every node has a direct peer-to-peer tunnel to every&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;node. Each peer uses STUN to discover its public&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;endpoint for NAT traversal. Falls back to relay via&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;the bridge when direct connectivity fails.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#E6F1EA;strokeColor=#2F8A57;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#1E6B40;align=left;verticalAlign=top;spacing=0;spacingLeft=14;spacingRight=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="625" height="126" as="geometry"/></mxCell>
        <mxCell id="architecture-detailed-23" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2F8A57;strokeWidth=2.5;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="112.5" y="384" as="sourcePoint"/><mxPoint x="112.5" y="410" as="targetPoint"/></mxGeometry></mxCell>
