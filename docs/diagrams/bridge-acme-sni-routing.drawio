<mxfile host="drawio" type="device">
  <diagram id="bridge-acme-sni-routing" name="How a bridge routes a TLS connection by its server name">
    <mxGraphModel dx="1120" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1120" pageHeight="950" background="#F6F5F1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bridge-acme-sni-routing-1" value="&lt;span style=&quot;font-size:20px;color:#2B3440;font-weight:bold;&quot;&gt;Public internet clients&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;HTTPS / TLS&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="70" y="40" width="340" height="76" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-2" value="&lt;span style=&quot;font-size:20px;color:#4B3592;font-weight:bold;&quot;&gt;ACME CA&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;TLS-ALPN-01&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FDFCF9;strokeColor=#5E43A8;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#4B3592;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="650" y="40" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-3" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FBEFE3;strokeColor=#C9620F;strokeWidth=2;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1040" height="720" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-4" value="&lt;span style=&quot;font-size:22px;color:#2B3440;font-weight:bold;&quot;&gt;Bridge node&lt;/span&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=22;fontColor=#2B3440;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="202" width="157" height="27" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-5" value="&lt;span style=&quot;font-size:17px;color:#1E6B40;font-weight:bold;font-family:IBM Plex Mono;&quot;&gt;IngressManager&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;one listener per SNI port (:443)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FDFCF9;strokeColor=#2F8A57;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#1E6B40;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="480" height="70" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2457C5;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="116" as="sourcePoint"/><mxPoint x="240" y="270" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="bridge-acme-sni-routing-7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2457C5;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="116" as="sourcePoint"/><mxPoint x="440" y="270" as="targetPoint"/><Array as="points"><mxPoint x="710" y="153"/><mxPoint x="440" y="153"/></Array></mxGeometry></mxCell>
        <mxCell id="bridge-acme-sni-routing-8" value="&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;TLS ClientHello&lt;/span&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="272.5" y="216" width="135" height="21" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-9" value="&lt;span style=&quot;font-size:17px;color:#1E6B40;font-weight:bold;font-family:IBM Plex Mono;&quot;&gt;ACMEManager&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;one autocert.Manager&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;per account&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FDFCF9;strokeColor=#2F8A57;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#1E6B40;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="600" y="260" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2457C5;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="260" as="sourcePoint"/><mxPoint x="810" y="116" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="bridge-acme-sni-routing-11" value="&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;HTTPS to the block's&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#55606E;font-family:IBM Plex Mono;&quot;&gt;directory_url&lt;/span&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=16;fontColor=#55606E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="127" width="181" height="40" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-12" value="&lt;span style=&quot;font-size:20px;color:#0B5F69;font-weight:bold;&quot;&gt;DirCache&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#55606E;font-family:IBM Plex Mono;&quot;&gt;&amp;lt;data_dir&amp;gt;/acme&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#E3F1F2;strokeColor=#0E7D89;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=16;fontColor=#0B5F69;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="880" y="256" width="180" height="98" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#B0387F;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="305" as="sourcePoint"/><mxPoint x="880" y="305" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="bridge-acme-sni-routing-14" value="&lt;span style=&quot;font-size:17px;color:#2B3440;font-weight:bold;font-family:IBM Plex Mono;&quot;&gt;peekClientHello&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;crypto/tls parses the hello, at most&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;16 KiB and 5 s, nothing is answered;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;it returns the server name and the offered ALPN&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="70" y="410" width="480" height="120" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A4452;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="340" as="sourcePoint"/><mxPoint x="310" y="410" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="bridge-acme-sni-routing-16" value="&lt;span style=&quot;font-size:17px;color:#2B3440;font-weight:bold;&quot;&gt;answer the challenge,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;then close&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="810" y="430" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A4452;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="470" as="sourcePoint"/><mxPoint x="810" y="470" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="bridge-acme-sni-routing-18" value="&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;on :443, ALPN exactly&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;acme-tls/1 for a host&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;of an acme rule&lt;/span&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="583.5" y="402" width="193" height="62" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-19" value="&lt;span style=&quot;font-size:17px;color:#2B3440;font-weight:bold;font-family:IBM Plex Mono;&quot;&gt;ingressTable.match(server name)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;exact host first, then a wildcard of one label&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="70" y="590" width="480" height="90" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A4452;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="530" as="sourcePoint"/><mxPoint x="310" y="590" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="bridge-acme-sni-routing-21" value="&lt;span style=&quot;font-size:17px;color:#2B3440;font-weight:bold;&quot;&gt;passthrough rule&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;dial the target, replay&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;the peeked bytes,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;copy both ways&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="70" y="770" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-22" value="&lt;span style=&quot;font-size:17px;color:#2B3440;font-weight:bold;&quot;&gt;terminate or acme rule&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;TLS handshake at the bridge,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;dial the target,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;copy the plaintext&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FDFCF9;strokeColor=#3A4452;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#2B3440;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="410" y="770" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-23" value="&lt;span style=&quot;font-size:17px;color:#A3262E;font-weight:bold;&quot;&gt;no rule, no server name,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#A3262E;font-weight:bold;&quot;&gt;a rule with a reason,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#A3262E;font-weight:bold;&quot;&gt;or no certificate&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#A3262E;&quot;&gt;close the connection&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#F8E8E9;strokeColor=#C6343C;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#A3262E;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="750" y="770" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="bridge-acme-sni-routing-24" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A4452;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="680" as="sourcePoint"/><mxPoint x="220" y="770" as="targetPoint"/><Array as="points"><mxPoint x="310" y="725"/><mxPoint x="220" y="725"/></Array></mxGeometry></mxCell>
        <mxCell id="bridge-acme-sni-routing-25" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A4452;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="680" as="sourcePoint"/><mxPoint x="560" y="770" as="targetPoint"/><Array as="points"><mxPoint x="310" y="725"/><mxPoint x="560" y="725"/></Array></mxGeometry></mxCell>
        <mxCell id="bridge-acme-sni-routing-26" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#C6343C;strokeWidth=2.5;endArrow=block;endFill=1;endSize=8;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="635" as="sourcePoint"/><mxPoint x="900" y="770" as="targetPoint"/><Array as="points"><mxPoint x="900" y="635"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
