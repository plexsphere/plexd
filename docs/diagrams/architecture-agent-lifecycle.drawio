        <mxCell id="architecture-agent-lifecycle-24" value="&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;on shutdown&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;or command&lt;/span&gt;" style="text;fillColor=none;strokeColor=none;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#55606E;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="257" y="229.8" width="116" height="41" as="geometry"/></mxCell>
        <mxCell id="architecture-agent-lifecycle-25" value="&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;1. Stop accepting new work&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;2. Drain in-flight executions:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;    up to 30 s, then cancelled&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;3. Tear down tunnels&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;4. Stop subsystems&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;The local identity is kept.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#EEF0F3;strokeColor=#7D8794;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#55606E;align=left;verticalAlign=top;spacing=0;spacingLeft=14;spacingRight=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="338.8" width="360" height="143" as="geometry"/></mxCell>
