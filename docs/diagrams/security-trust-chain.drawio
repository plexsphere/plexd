        <mxCell id="security-trust-chain-10" value="&lt;span style=&quot;font-size:20px;color:#2B3440;font-weight:bold;&quot;&gt;Trust anchor&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;distributes public keys, PSKs, and its&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#55606E;&quot;&gt;own Ed25519 signing public key&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#EEF0F3;strokeColor=#7D8794;strokeWidth=2;whiteSpace=wrap;html=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;fontSize=17;fontColor=#2B3440;align=left;verticalAlign=top;spacing=0;spacingLeft=14;spacingRight=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="510" y="185" width="344" height="85" as="geometry"/></mxCell>
